{
  "name": "detectic-backend-cf",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "npx wrangler dev",
    "deploy": "npx wrangler deploy",
    "db:init": "npx wrangler d1 execute detectic-db --file=schema.sql",
    "db:init:local": "npx wrangler d1 execute detectic-db --local --file=schema.sql",
    "test": "npx wrangler dev --port 8787",
    "test:unit": "node --experimental-strip-types tests/protocol.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "web-push-browser": "^1.4.2"
  }
}
