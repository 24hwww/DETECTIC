# Detectic — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to Git.

# --- Router connection ---
DETECTIC_URL=http://192.168.0.1
DETECTIC_USER=user
DETECTIC_PASSWORD=
DETECTIC_DIALECT=json

# --- Sensor identity ---
DETECTIC_SENSOR_ID=home-001
DETECTIC_SECRET=

# --- Polling ---
DETECTIC_INTERVAL=30
DETECTIC_ABSENCE_THRESHOLD=3

# --- Backend upload (optional) ---
DETECTIC_BACKEND_URL=
DETECTIC_BACKEND_TOKEN=
DETECTIC_BACKEND_TIMEOUT=10

# --- Offline buffer ---
DETECTIC_DB=detectic_sensor.db
DETECTIC_BUFFER_MAX=65536

# --- Optional data sources ---
DETECTIC_SITE_SURVEY=0
DETECTIC_RADIO_STATS=0

# --- Logging ---
DETECTIC_LOG_LEVEL=info
DETECTIC_LOG_MACS=0

# --- SMTP notifications ---
SMTP_ENABLED=0
DETECTIC_SMTP_HOST=
DETECTIC_SMTP_PORT=587
DETECTIC_SMTP_USER=
DETECTIC_SMTP_PASSWORD=
DETECTIC_SMTP_FROM=
DETECTIC_SMTP_TO=
DETECTIC_SMTP_TLS=starttls

# --- Reporting interval (seconds, default 3600 = 1 hour) ---
DETECTIC_REPORT_INTERVAL=3600
