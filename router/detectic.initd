#!/bin/sh /etc/rc.common
# Detectic sensor service for the TP-Link EX520v (OpenWrt-based firmware).
#
# Installs the statically-linked `detectic` ARM64 binary as a procd-managed
# daemon that polls the router's GDPRAPI and uploads (or buffers) the map.
# Config lives in /etc/detectic.conf (shell env vars).

START=99
STOP=10
USE_PROCD=1

NAME=detectic
PROG=/usr/bin/detectic
CONF=/etc/detectic.conf

start_service() {
    # Load operator config (safe: operator-provided file on the router).
    [ -f "$CONF" ] && . "$CONF"

    procd_open_instance "$NAME"
    procd_set_param command "$PROG" sensor
    procd_set_param env DETECTIC_URL="${DETECTIC_URL:-http://127.0.0.1}"
    procd_set_param env DETECTIC_USER="${DETECTIC_USER:-user}"
    procd_set_param env DETECTIC_PASSWORD="${DETECTIC_PASSWORD:-}"
    procd_set_param env DETECTIC_DIALECT="${DETECTIC_DIALECT:-json}"
    procd_set_param env DETECTIC_INTERVAL="${DETECTIC_INTERVAL:-30}"
    procd_set_param env DETECTIC_UPLOAD_URL="${DETECTIC_UPLOAD_URL:-}"
    procd_set_param env DETECTIC_SENSOR_ID="${DETECTIC_SENSOR_ID:-}"
    procd_set_param env DETECTIC_SECRET="${DETECTIC_SECRET:-}"
    procd_set_param env DETECTIC_BUFFER="${DETECTIC_BUFFER:-/tmp/detectic_buffer.jsonl}"
    procd_set_param env DETECTIC_BUFFER_MAX="${DETECTIC_BUFFER_MAX:-65536}"
    procd_set_param respawn              # auto-restart on crash (bounded)
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# Do NOT keep the binary or buffer on a read-only overlay longer than needed;
# /tmp buffer is volatile by design (AGENTS.md §29: never fill flash).
service_triggers() {
    procd_add_reload_trigger "$NAME"
}
