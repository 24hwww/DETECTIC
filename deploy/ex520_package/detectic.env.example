# DETECTIC environment file for EX520 sensor.
# Copy to detectic.env, set real values, chmod 600.
# NEVER commit detectic.env.

# Router GTPR API (use LAN IP, NOT 127.0.0.1 which returns 406)
DETECTIC_URL=http://192.168.0.1
DETECTIC_USER=user
DETECTIC_PASSWORD=REPLACE_ME
# Per-sensor secret. MUST equal the backend's DETECTIC_SENSORS["ex520-001"]
# value. It is used for device pseudonymization, HTTP HMAC auth, AND the WSS
# sensor credential (realtime.ts validates it against the registry).
# NEVER commit the real value.
DETECTIC_SECRET=REPLACE_ME
DETECTIC_SENSOR_ID=ex520-001
DETECTIC_INTERVAL=30
DETECTIC_ROUTER_TIMEOUT=15
# WSS for real-time dashboard via Cloudflare Durable Object
DETECTIC_BACKEND_URL=wss://detectic.24hwww.workers.dev/ws
DETECTIC_BUFFER=/var/run/misc/misc_rw/detectic/spool/detectic_buffer.jsonl
DETECTIC_BUFFER_MAX=262144
DETECTIC_LOG_LEVEL=info
DETECTIC_LOG_MACS=0
DETECTIC_HTTP_PORT=8787
DETECTIC_HTTP_SERVER=1
# mDNS advertises detectic.local on the LAN (needs non-loopback DETECTIC_URL)
DETECTIC_MDNS=1
DETECTIC_MDNS_HOSTNAME=detectic
DETECTIC_ARP=1
DETECTIC_ARP_INTERVAL=10
