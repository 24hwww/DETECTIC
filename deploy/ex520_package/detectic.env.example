# ============================================================================
# Detectic Sensor — EX520 Environment Configuration
# ============================================================================
# Copy this file to detectic.env and fill in real values.
# NEVER commit detectic.env to Git (it's in .gitignore).
# ============================================================================

# --- Router connection (local GTPR/GDPR) ---
DETECTIC_URL=http://192.168.0.1
DETECTIC_USER=user
DETECTIC_PASSWORD=
DETECTIC_INTERVAL=60

# --- Sensor identity ---
DETECTIC_SENSOR_ID=ex520-001
# Must match DETECTIC_SENSORS["ex520-001"] on the Cloudflare Worker
DETECTIC_SECRET=

# --- Email notifications (optional) ---
DETECTIC_EMAILD=http://192.168.0.27:8081/email
DETECTIC_EMAIL_INTERVAL=300

# --- Backend: Cloudflare Worker via local forwarder ---
# The EX520 binary has no TLS → sends HTTP to the host forwarder →
# forwarder proxies to https://detectic.24hwww.workers.dev via HTTPS.
#
# Option A: Via forwarder (recommended, works with stock binary)
DETECTIC_UPLOAD_URL=http://192.168.0.27:8082/api/v1/events
#
# Option B: Direct to Cloudflare (requires TLS-enabled binary)
# DETECTIC_UPLOAD_URL=https://detectic.24hwww.workers.dev/api/v1/events
