[Unit]
Description=Detectic Local Relay (EX520 → Cloudflare Worker)
After=network-online.target cloudflared.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/detectic
ExecStart=/usr/bin/python3 /opt/detectic/relay.py --port 8082
Restart=always
RestartSec=3
StartLimitInterval=60
StartLimitBurst=10

# Worker URL (via cloudflared tunnel or direct)
Environment=DETECTIC_WORKER_URL=https://detectic.24hwww.workers.dev/api/v1/events

# Memory limit
MemoryMax=64M

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/detectic
ProtectHome=yes
PrivateTmp=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=detectic-relay

[Install]
WantedBy=multi-user.target
